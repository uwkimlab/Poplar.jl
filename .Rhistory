# -------------------------------------------
library(ggplot2)    # For plotting
library(scales)     # For formatting numeric labels (e.g., comma-separated)
library(patchwork)  # For combining multiple plots
library(readxl)     # For reading Excel files
library(stringr)
library(tidyverse)
library(ggpubr)
library(data.table)
data_cascade <- read.csv("C:/Users/szerr/cascadeWA.csv", stringsAsFactors = FALSE)
#df <- tibble(
#  date = as.Date("2019-01-01") + 0:49,
#  outcome = rnorm(50),
#  value = rnorm(50)
#)
data_cascade$time <- as.POSIXct(data_cascade$time)
data_cascade$year <- year(data_cascade$time)
data_cascade$standAge <- as.numeric(data_cascade$standAge)
data_cascade$Tree<- as.numeric(str_extract(data_cascade$W_ton, "^\\S*"))
data_cascade$Foliage <- as.numeric(str_extract(data_cascade$WF_ton, "^\\S*"))
data_cascade$Stem <- as.numeric(str_extract(data_cascade$WS_ton, "^\\S*"))
data_cascade$Root <- as.numeric(str_extract(data_cascade$WR_ton, "^\\S*"))
data_cascade$Q_sun <- as.numeric(str_extract(data_cascade$Q_sun, "^\\S*"))
data_cascade$A_gross <- as.numeric(str_extract(data_cascade$A_gross, "^\\S*"))
data_cascade$solrad <- as.numeric(str_extract(data_cascade$solrad, "^\\S*"))
data_cascade$LAI <- as.numeric(str_extract(data_cascade$LAI, "^\\S*"))
data_cascade$slope <- numeric(length(data_cascade$LAI))
plot(data_cascade$Q_sun)
plot(data_cascade$A_gross)
august_data = filter(data_cascade, month(data_cascade$time)==8)
august_data$A_gross
data_cascade$location <- "Washington"
data_cascade$model <- "Cropbox"
new_dataframe <- data.frame(year= 2013:2017,slope=numeric(5))
for (date in 0:4){
print(as.numeric(date))
check = as.numeric(2013+as.numeric(date))
print(check)
yearly <- filter(august_data, year==check,solrad<400)
new_dataframe$slope[date+1] <- coef(lm(yearly$A_gross ~ yearly$solrad, data = yearly))[2]
ind<-which(data_cascade$time==paste(as.character(check),'-08-01 PDT',sep=''))
data_cascade$slope[ind[1]] <- new_dataframe$slope[date+1]
#new_dataframe$slope[date+1]
}
data_oregon <-  read.csv("C:/Users/szerr/willOR.csv", stringsAsFactors = FALSE)
data_oregon$time <- as.POSIXct(data_oregon$time)
data_oregon$year <- year(data_oregon$time)
data_oregon$standAge <- as.numeric(data_oregon$standAge)
data_oregon$Tree<- as.numeric(str_extract(data_oregon$W_ton, "^\\S*"))
data_oregon$Foliage <- as.numeric(str_extract(data_oregon$WF_ton, "^\\S*"))
data_oregon$Stem <- as.numeric(str_extract(data_oregon$WS_ton, "^\\S*"))
data_oregon$Root <- as.numeric(str_extract(data_oregon$WR_ton, "^\\S*"))
data_oregon$Q_sun <- as.numeric(str_extract(data_oregon$Q_sun, "^\\S*"))
data_oregon$A_gross <- as.numeric(str_extract(data_oregon$A_gross, "^\\S*"))
data_oregon$solrad <- as.numeric(str_extract(data_oregon$solrad, "^\\S*"))
data_oregon$LAI <- as.numeric(str_extract(data_oregon$LAI, "^\\S*"))
data_oregon$slope <- numeric(length(data_oregon$LAI))
new_dataframe <- data.frame(year= 2012:2017,slope=numeric(6))
august_data = filter(data_oregon, month(data_oregon$time)==8)
august_data$A_gross
data_oregon$location <- "Oregon"
data_oregon$model <- "Cropbox"
for (date in 0:4){
print(as.numeric(date))
check = as.numeric(2012+as.numeric(date))
print(check)
yearly <- filter(august_data, year==check,solrad<400)
new_dataframe$slope[date+1] <- coef(lm(yearly$A_gross ~ yearly$solrad, data = yearly))[2]
#print(~lm(dtaA_gross ~ solrad, data = filter(data, data$year==date)))
ind<-which(data_oregon$time==paste(as.character(check),'-08-01',sep=''))
data_oregon$slope[ind[1]] <- new_dataframe$slope[date+1]
}
yearly <- filter(august_data, year==2015,solrad<400)
data_plot <- data_oregon %>%
select("time","slope","LAI") %>%
pivot_longer(-time, names_to = "variable", values_to = "value")
first_yr <- filter(august_data, year==1999)
sec_yr <- filter(august_data, year==2000)
thrd_yr <- filter(august_data, year==2001)
plot(thrd_yr$solrad,thrd_yr$A_gross)
